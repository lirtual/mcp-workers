# Dependencies and generated output
**/node_modules/
**/.wrangler/
**/.build/
**/dist/
**/coverage/
**/.cache/
**/tmp/
**/*.log
apps/remote-control-agent/
apps/remote-control-mcp-worker/.wrangler-release.jsonc

# Secrets: examples remain trackable; actual values never belong in Git
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
!.dev.vars.example
!**/.dev.vars.example
**/.npmrc
**/.pypirc
**/credentials.json
**/service-account*.json
**/*secrets*.local.*
**/*secret*.local.*
**/*.pem
**/*.p12
**/*.pfx
**/*.key
**/id_rsa
**/id_ed25519
**/id_ecdsa
**/id_dsa
**/known_hosts

# Machine state and credentials in databases/backups
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
**/*.tfstate
**/*.tfstate.*
**/*.bak
**/*.backup
**/*.dump
**/*.sql.gz

# Local public snapshots should never be committed
/public-export/
/public-export-*/

**/__pycache__/
