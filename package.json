    "check": "pnpm run typecheck && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "imapflow": "^1.6.6",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/nodemailer": "^8.0.1",
    "typescript": "^6.0.0",
    "wrangler": "4.130.0"
  }
