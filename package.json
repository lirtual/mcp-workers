{
  "name": "email-mcp-worker-runtime-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "THROWAWAY Cloudflare Workers IMAP/SMTP runtime probe",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
