{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-gateway-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "routes": [
    {
      "pattern": "mcp-gateway.lirtual.dpdns.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 0
    }
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
      "CF_ACCESS_CLIENT_SECRET"
    ]
  }
}
