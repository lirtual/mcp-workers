{
  "name": "instapaper-mcp-worker",
  "version": "2.0.0",
  "description": "Instapaper MCP server for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "check": "pnpm run typecheck && pnpm test && pnpm run deploy:dry-run",
    "setup:instapaper": "tsx scripts/setup-instapaper.ts"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.0",
    "oauth-1.0a": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.105.0"
  },
  "keywords": [
    "mcp",
    "instapaper",
    "model-context-protocol",
    "cloudflare-workers"
  ],
  "license": "MIT"
}
