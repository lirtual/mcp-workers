{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "database-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN",
      "DATABASE_ENCRYPTION_KEY",
      "DATABASE_KEY_ID",
      "DATABASE_GITHUB_ACTIONS_TOKEN"
    ]
  },
  "vars": {
    "DATABASE_MAX_ROWS": "500",
    "DATABASE_MAX_RESULT_BYTES": "1048576",
    "DATABASE_MAX_SCHEMA_BYTES": "524288",
    "DATABASE_QUERY_TIMEOUT_MS": "15000",
    "DATABASE_MAX_WRITE_AFFECTED_ROWS": "20",
    "DATABASE_SETUP_HOST": "database.lirtual.dpdns.org"
  },
  "ratelimits": [
    {
      "name": "SETUP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "hyperdrive": [],
  "routes": [
    {
      "pattern": "database.lirtual.dpdns.org",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database-mcp-registry",
      "database_id": "cbfe6a05-4979-4e6a-9cc2-4f6468586e4a",
      "migrations_dir": "migrations"
    }
  ]
}
