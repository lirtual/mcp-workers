{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "database-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "CONNECTIONS_JSON": "[{\"id\":\"prod_pg\",\"displayName\":\"Production PostgreSQL\",\"dialect\":\"postgres\",\"binding\":\"PROD_PG_READ\",\"enabled\":true,\"defaultSchema\":\"public\"},{\"id\":\"prod_mysql\",\"displayName\":\"Production MySQL\",\"dialect\":\"mysql\",\"binding\":\"PROD_MYSQL_READ\",\"enabled\":true}]",
    "OAUTH_ISSUER": "https://auth.example.com",
    "OAUTH_AUDIENCE": "https://database-mcp.example.com/mcp",
    "OAUTH_JWKS_URL": "https://auth.example.com/.well-known/jwks.json",
    "OAUTH_REQUIRED_SCOPE": "db:read",
    "MAX_ROWS": "500",
    "MAX_RESULT_BYTES": "1048576",
    "MAX_SCHEMA_BYTES": "524288",
    "QUERY_TIMEOUT_MS": "15000"
  },
  "hyperdrive": [
    { "binding": "PROD_PG_READ", "id": "<CACHE_DISABLED_HYPERDRIVE_ID>" },
    { "binding": "PROD_MYSQL_READ", "id": "<CACHE_DISABLED_HYPERDRIVE_ID>" }
  ],
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"1001","simple":{"limit":120,"period":60}}]
}
