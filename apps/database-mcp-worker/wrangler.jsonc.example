{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "database-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN"
    ]
  },
  "vars": {
    "DATABASE_MAX_ROWS": "500",
    "DATABASE_MAX_RESULT_BYTES": "1048576",
    "DATABASE_MAX_SCHEMA_BYTES": "524288",
    "DATABASE_QUERY_TIMEOUT_MS": "15000",
    "DATABASE_MAX_WRITE_AFFECTED_ROWS": "20",
    "DATABASE_CONNECTIONS": "{}"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_AIVEN_MYSQL",
      "id": "31fc05c77ac042ff927a6d3cbf5bbb7d"
    },
    {
      "binding": "HYPERDRIVE_AIVEN_POSTGRES",
      "id": "b2c7dab22f594bbca255827065e19bce"
    }
  ]
}
