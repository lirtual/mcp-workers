{
  "name": "@mcp-workers/remote-control-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loopback agent that supervises pinned Desktop Commander for one local read.",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@wonderwhy-er/desktop-commander": "0.2.52"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
