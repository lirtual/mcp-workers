{
  "name": "browser-mcp-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./.build/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": false,
  "routes": [{"pattern":"browser.lirtual.dpdns.org","custom_domain":true}],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROWSER_OWNER",
        "class_name": "BrowserOwner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "browser-v1",
      "new_sqlite_classes": [
        "BrowserOwner"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 0
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN"
    ]
  }
}
