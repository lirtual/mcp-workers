{
  "name": "browser-mcp-worker",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:workerd": "node tests/workerd-smoke.mjs",
    "test:workerd:restart": "node tests/workerd-restart-smoke.mjs",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.mjs && wrangler deploy --dry-run --outdir .build/dry-run"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.151.0"
  }
}
