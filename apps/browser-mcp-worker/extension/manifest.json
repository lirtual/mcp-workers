{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Browser MCP",
  "version": "0.1.0",
  "description": "Owner-approved remote control of this browser profile (Spec #418).",
  "minimum_chrome_version": "137",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser MCP — local control",
    "default_popup": "popup.html"
  },
  "key": ""
}
