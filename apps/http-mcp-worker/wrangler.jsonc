{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "http-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN"
    ]
  }
}
