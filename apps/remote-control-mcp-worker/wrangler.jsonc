{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remote-control-mcp-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "rca.lirtual.dpdns.org", "custom_domain": true }
  ],
  "keep_vars": false,
  "services": [
    { "binding": "WORKFLOW_SESSION_AUTHORIZATION", "service": "workflow-mcp-worker", "entrypoint": "SessionAuthorization" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_COORDINATOR",
        "class_name": "DeviceCoordinator"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN"
    ]
  },
  "exports": {
    "DeviceCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
