{
  "name": "remote-control-mcp-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portal-authenticated MCP worker for paired devices over WebSocket and Durable Objects.",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bash scripts/run-tests.sh",
    "check": "pnpm --filter remote-control-agent build:shell && pnpm run typecheck && pnpm test && pnpm run check:v2-production",
    "check:v2-production": "wrangler deploy --dry-run --config wrangler.jsonc --outdir .build/v2-production",
    "types": "wrangler types"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "wrangler": "4.151.0"
  }
}
