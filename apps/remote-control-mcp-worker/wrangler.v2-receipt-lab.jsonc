{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remote-control-v2-receipt-lab",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "vars": {
    "REMOTE_CONTROL_V2_RECEIPT_LAB_ONLY": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "V2_OWNER",
        "class_name": "V2OwnerCoordinator"
      }
    ]
  },
  "exports": {
    "V2OwnerCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN"
    ]
  }
}
