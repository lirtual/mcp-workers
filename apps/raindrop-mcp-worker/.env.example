# Raindrop.io API Access Token (REQUIRED)
# Create one at https://app.raindrop.io/settings/integrations
RAINDROP_ACCESS_TOKEN=YOUR_RAINDROP_ACCESS_TOKEN

# Cloudflare MCP Portal -> Worker credential (REQUIRED for /mcp)
# Generate a separate high-entropy secret. Cloudflare MCP Portal sends it as
# Authorization: Bearer <MCP_ACCESS_TOKEN> when connecting to this Worker.
# Never reuse RAINDROP_ACCESS_TOKEN here or reuse this value for another Worker.
MCP_ACCESS_TOKEN=YOUR_INDEPENDENT_PORTAL_SECRET
