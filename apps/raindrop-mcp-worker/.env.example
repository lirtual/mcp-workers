# Raindrop.io API Access Token (REQUIRED)
# Create one at https://app.raindrop.io/settings/integrations
RAINDROP_ACCESS_TOKEN=YOUR_RAINDROP_ACCESS_TOKEN

# Cloudflare Worker origin credential (REQUIRED for /mcp on Worker deployments)
# Generate a separate high-entropy secret. Cloudflare MCP Portal sends it as
# Authorization: Bearer <MCP_ORIGIN_TOKEN> when connecting to this Worker.
# Never reuse RAINDROP_ACCESS_TOKEN here.
MCP_ORIGIN_TOKEN=YOUR_INDEPENDENT_ORIGIN_SECRET

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
