    "check": "pnpm run typecheck && pnpm test && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
