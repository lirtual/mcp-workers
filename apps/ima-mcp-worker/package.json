{
  "name": "ima-mcp-worker",
  "version": "0.5.0",
  "description": "Cloudflare Workers-native Model Context Protocol (MCP) server for Tencent IMA notes and knowledge bases",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
