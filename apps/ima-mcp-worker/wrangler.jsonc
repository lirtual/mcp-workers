{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ima-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN",
      "API_KEY",
      "CLIENT_ID"
    ]
  },
  "vars": {
    "R2_PUBLIC_BASE_URL": "https://ima-files.lirtual.dpdns.org"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "ima-mcp-worker"
    }
  ]
}
