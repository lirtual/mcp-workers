# Local development only. Copy to .dev.vars; never commit secrets.
CLIENT_ID=
API_KEY=
MCP_ACCESS_TOKEN=

# Public custom domain bound directly to the R2 bucket used for exported files.
# Production currently uses https://temp.lirtual.dpdns.org.
R2_PUBLIC_BASE_URL=http://localhost:8787

# Configure R2 object lifecycle separately for the exports/ prefix when automatic
# cleanup is desired. Export downloads do not pass through the Worker.
