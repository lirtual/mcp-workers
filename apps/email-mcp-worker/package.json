{
  "name": "email-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native multi-account email MCP server with bounded IMAP reads and gated SMTP/mutation capabilities",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0",
    "imapflow": "^2.0.5",
    "postal-mime": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.36.0"
  }
}
