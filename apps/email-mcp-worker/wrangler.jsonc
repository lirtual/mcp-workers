{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "email-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "secrets": {
    "required": ["MCP_ACCESS_TOKEN", "MAIL_ENCRYPTION_KEY", "ACCESS_TEAM_DOMAIN", "ACCESS_AUD", "OWNER_EMAIL"]
  }
}
