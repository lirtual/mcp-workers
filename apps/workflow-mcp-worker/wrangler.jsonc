{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "workflow-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "workflow.lirtual.dpdns.org", "custom_domain": true }],
  "keep_vars": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "d1_databases": [
    { "binding": "DB", "database_name": "workflow-mcp-worker",
      "database_id": "c76850db-b5e3-4128-9150-849a1c9e8d74", "migrations_dir": "migrations" }
  ],
  "workflows": [{ "name": "workflow-mcp-runner", "binding": "WORKFLOW", "class_name": "WorkflowRunner" }],
  "services": [{ "binding": "READONLY_TARGET", "service": "workflow-readonly-fixture" }],
  "secrets": { "required": ["MCP_ACCESS_TOKEN"] }
}
