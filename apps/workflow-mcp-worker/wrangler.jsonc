{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "workflow-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "workflow.lirtual.dpdns.org", "custom_domain": true }],
  "keep_vars": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "d1_databases": [
    { "binding": "DB", "database_name": "workflow-mcp-worker",
      "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "workflows": [{ "name": "workflow-mcp-s1", "binding": "WORKFLOW", "class_name": "WorkflowRunner" }],
  "services": [{ "binding": "READONLY_TARGET", "service": "workflow-s1-readonly-fixture" }],
  "secrets": { "required": ["MCP_ACCESS_TOKEN"] }
}
