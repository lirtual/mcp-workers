{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "workflow-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "workflow.lirtual.dpdns.org", "custom_domain": true }],
  "keep_vars": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "d1_databases": [
    { "binding": "DB", "database_name": "workflow-mcp-db",
      "database_id": "a4a477cd-6339-478c-ab7c-f7d87bb0d772", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    { "binding": "ACTIONS", "service": "cloudflare-actions", "entrypoint": "ActionsEntrypoint" }
  ],
  "workflows": [
    { "name": "workflow-mcp-orchestrator", "binding": "WORKFLOW", "class_name": "WorkflowOrchestrator" }
  ],
  "secrets": { "required": ["MCP_ACCESS_TOKEN", "MCP_PORTAL_CLIENT_SECRET", "WORKFLOW_GITHUB_DISPATCH_TOKEN", "SESSION_RUNTIME_DATA_KEY"] }
}
