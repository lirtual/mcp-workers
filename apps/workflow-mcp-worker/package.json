{
  "name": "workflow-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test && node --check tests/production-smoke.mjs && pnpm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .build/workflow"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.2",
    "yaml": "2.8.2",
    "@modelcontextprotocol/client": "2.0.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "6.0.3",
    "wrangler": "4.130.0",
    "@types/node": "24.10.4"
  }
}
