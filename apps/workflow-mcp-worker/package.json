{
  "name": "workflow-mcp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-native deterministic workflow runtime with MCP control surface",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "registry:generate": "tsx scripts/compile-workflows.ts",
    "registry:validate": "tsx scripts/compile-workflows.ts --validate",
    "release:raindrop-manual": "tsx scripts/verify-raindrop-manual.ts",
    "deploy:dry-run": "wrangler deploy src/index.ts --dry-run --name workflow-mcp-worker --compatibility-date 2026-09-18 --compatibility-flag nodejs_compat",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm run registry:check && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run deploy:dry-run",
    "registry:check": "pnpm run registry:generate && git diff --exit-code -- src/generated/workflow-registry.ts",
    "release:compatibility": "tsx scripts/check-release-compatibility.ts --remote"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "2.9.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0",
    "wrangler": "4.130.0"
  }
}
