{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openlist-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "OPENLIST_READONLY": "true",
    "OPENLIST_UPLOAD_MAX_BYTES": "5242880",
    "OPENLIST_TIMEOUT_MS": "15000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": ["MCP_ACCESS_TOKEN", "OPENLIST_TOKEN"]
  }
}
