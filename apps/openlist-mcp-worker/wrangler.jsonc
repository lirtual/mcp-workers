{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openlist-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 }
  },
  "services": [{ "binding": "OPENLIST", "service": "openlist-tsworkers" }],
  "secrets": { "required": ["MCP_ACCESS_TOKEN", "OPENLIST_API_TOKEN"] }
}
