{
  "name": "openlist-mcp-worker",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .build/openlist",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@mcp-workers/portal-auth": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "typescript": "6.0.3",
    "wrangler": "4.130.0"
  }
}
