{
  "name": "ssh-mcp-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:g0": "node --experimental-strip-types g0/test/run.ts",
    "test:exec": "node --experimental-strip-types tests/e2e/run.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run test:g0 && pnpm run test:exec"
  },
  "dependencies": {
    "@meitaim/ssh": "1.0.0",
    "@mcp-workers/portal-auth": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "24.19.2",
    "ssh2": "1.17.0",
    "typescript": "6.0.3",
    "wrangler": "4.130.0"
  }
}
