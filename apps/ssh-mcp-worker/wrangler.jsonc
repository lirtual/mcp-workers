{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ssh-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "SSH_OPERATIONS",
        "class_name": "SshOperationsDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SshOperationsDO"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "secrets": {
    "required": [
      "MCP_ACCESS_TOKEN",
      "ENCRYPTION_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "EDGE_SSH_DB",
      "database_name": "edgessh-accounts",
      "database_id": "bd5cfdc5-3db0-4af7-8e95-cbf3d65cfa94"
    }
  ]
}
